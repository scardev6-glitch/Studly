# ═══════════════════════════════════════════════════════════════════
# Studly App - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to config.env and fill in your actual values

# ─── Server Configuration ───
PORT=3000
NODE_ENV=production

# ─── Database Configuration ───
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/studly?retryWrites=true&w=majority

# ─── Authentication & Security ───
JWT_SECRET=your_super_secret_jwt_key_123
JWT_EXPIRE=24h

# ─── Google Generative AI (Gemini API) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Email Service Configuration ───
# Options: gmail, smtp, sendgrid, test
EMAIL_SERVICE=smtp
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# For SendGrid (if using SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key

# ─── Frontend Configuration ───
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Authentication Rate Limiting ───
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ─── AI Rate Limiting ───
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

# ─── Development Only ───
AUTH_DISABLED=false
