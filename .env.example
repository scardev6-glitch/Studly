# ═════════════════════════════════════════════
# STUDLY APPLICATION ENVIRONMENT VARIABLES
# ═════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Server Configuration ───
# Port on which the server runs
PORT=3000

# ─── Database Configuration ───
# MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/studly?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/studly

# ─── Authentication ───
# JWT secret for token signing (use a strong random string, min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-with-at-least-32-characters-here

# ─── AI & Language Model ───
# Google Generative AI (Gemini) API key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# ─── Google Drive Integration ───
# Path to Google service account JSON key file
# If not set, defaults to ../studly-drive.json
GOOGLE_APPLICATION_CREDENTIALS=./studly-drive.json

# ─── Email Service ───
# Email service provider (gmail, sendgrid, mailgun, etc.)
# Leave empty or comment out to use test mode
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# EMAIL_FROM=noreply@studly.app

# ─── CORS Configuration ───
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,http://localhost:5173,https://studly.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Optional: Node Environment ───
# Set to 'production' for production deployments
NODE_ENV=development
