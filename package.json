{
  "name": "studly",
  "version": "2.0.0",
  "description": "Studly — EGCSE & JC mastery learning app for Eswatini students",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node scripts/seedData.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "postinstall": "npm run build:frontend",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:controllers": "jest tests/unit/controllers",
    "test:models": "jest tests/unit/models",
    "test:services": "jest tests/unit/services",
    "test:routes": "jest tests/integration/routes"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "studly",
    "egcse",
    "jc",
    "eswatini",
    "education"
  ],
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.18",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^9.5.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
